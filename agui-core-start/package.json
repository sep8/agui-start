{
  "name": "@agui-start-core/workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "run-p dev:client dev:server",
    "dev:client": "pnpm --filter @agui-start-core/client dev",
    "dev:server": "pnpm --filter @agui-start-core/server dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "type-check": "pnpm -r --if-present type-check",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.43",
    "@ag-ui/core": "^0.0.43"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.0.9",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}